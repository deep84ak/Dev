{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/market-data",
      "destination": "https://query1.finance.yahoo.com/v8/finance/chart/EURGBP=X?interval=1m&range=1d"
    }
  ],
  "headers": [
    {
      "source": "/market-data",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}